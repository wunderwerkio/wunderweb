---
// <head> metadata of a content page: title, description, robots, canonical,
// hreflang alternates, Open Graph image (as the Next adapter).
//
//   <head><Head page={page} /></head>
import type { SourcePage } from "@wunderweb/core";

import { headOf } from "../dist/index.mjs";

interface Props {
	page: SourcePage;
}

const head = headOf(Astro.props.page);
---
<title>{head.title}</title>
{head.description && <meta name="description" content={head.description} />}
{head.robots && <meta name="robots" content={head.robots} />}
<link rel="canonical" href={head.canonical} />
{head.alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
{head.image && <meta property="og:image" content={head.image.url} />}
{head.image?.width && <meta property="og:image:width" content={String(head.image.width)} />}
{head.image?.height && <meta property="og:image:height" content={String(head.image.height)} />}
{head.image?.alt && <meta property="og:image:alt" content={head.image.alt} />}
